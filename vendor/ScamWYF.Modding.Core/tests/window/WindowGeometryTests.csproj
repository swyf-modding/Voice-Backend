<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <LangVersion>7.3</LangVersion>
    <AssemblyName>WindowGeometryTests</AssemblyName>
    <RootNamespace>WindowGeometryTests</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>
  <ItemGroup>
    <!-- WindowGeometry.cs is copied in by build.ps1, so this compiles what actually ships. It has no
         Unity types in it precisely so this project needs no engine references. -->
    <Compile Include="WindowGeometry.cs" />
    <Compile Include="WindowGeometryTests.cs" />
  </ItemGroup>
</Project>